# 默认忽略所有文件
*

# 只保留 OKR 相关文件
!.gitignore
!okr-schedule.html
!okr_notify.py
!.github/
!.github/**
!CNAME

# 内部工具首页
!index.html

# 训练营排期看板
!camp-schedule/
!camp-schedule/**
!ai-camp-schedule/
!ai-camp-schedule/**

# Skill 共享平台
!skill-hub/
!skill-hub/**

# 训练营周复盘（tests/ 里放的是真实业务样例和开发规格，不提交）
!camp-review/
!camp-review/**
camp-review/tests/

# 销售话术复盘（仅提交使用虚构数据的回归测试，业务样例仍忽略）
!sales-script/
!sales-script/**
sales-script/tests/*
!sales-script/tests/logic.test.js
!sales-script/tests/ai.test.js
!sales-script/tests/todos.test.js
!sales-script/tests/db.test.js
!sales-script/tests/workflows.test.js
!sales-script/tests/proposals.test.js
!sales-script/tests/ai-status.test.js
!sales-script/tests/edge-function.test.js

!sales-script/tests/knowledge.test.js
!sales-script/tests/db-knowledge.test.js
!sales-script/tests/stream.test.js
!sales-script/tests/db-stream.test.js
!sales-script/tests/assistant-ui.test.js
!sales-script/tests/ai-log-delete.test.js
!sales-script/tests/reply-content.test.js
